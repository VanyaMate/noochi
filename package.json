{
  "name": "noochi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:infra": "node scripts/start-all.mjs",
    "dev:standalone": "node scripts/start-all.mjs",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "db:push": "pnpm --filter @noochi/db db:push",
    "db:seed": "pnpm --filter @noochi/db db:seed",
    "db:studio": "pnpm --filter @noochi/db db:studio",
    "check:infra": "node scripts/check-infra.mjs"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "tsx": "^4.19.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "@electric-sql/pglite"]
  }
}
